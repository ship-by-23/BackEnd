NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://simpandulu:simpandulu@localhost:5432/simpandulu
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_MAX_CONNECTIONS=10
SHUTDOWN_TIMEOUT_MS=10000
