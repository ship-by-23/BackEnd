{
  "name": "backend-simpandulu",
  "version": "0.1.0",
  "private": true,
  "description": "SimpanDulu REST API",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run src/db/schema.integration.test.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:demo": "tsx src/db/demo-seed.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@vercel/functions": "^3.9.9",
    "bcrypt": "^6.0.0",
    "cors": "2.8.6",
    "dotenv": "17.2.2",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "8.3.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "jsdom": "^30.1.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "sanitize-html": "^2.17.7",
    "undici": "^8.10.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.8",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
