NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/simpandulu
CORS_ORIGIN=https://app.example.com
LOG_LEVEL=info
DATABASE_MAX_CONNECTIONS=10
SHUTDOWN_TIMEOUT_MS=20000
ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=simpandulu-api
JWT_AUDIENCE=simpandulu-web
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=20
EXTRACTION_TIMEOUT_MS=15000
EXTRACTION_MAX_BYTES=2000000
EXTRACTION_MAX_REDIRECTS=5
EXTRACTION_POLL_INTERVAL_MS=500
EXTRACTION_STALE_LOCK_MS=300000
